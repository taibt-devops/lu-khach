<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- named "lagoon" because the shared adaptive-icon XML refers to it; here it is the dark marsh green of the HUD -->
    <color name="lagoon">#FF1E2A22</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <!-- Marsh green while the WebView loads, instead of a white flash -->
        <item name="android:windowBackground">@color/lagoon</item>
        <item name="android:statusBarColor">@color/lagoon</item>
        <item name="android:navigationBarColor">@color/lagoon</item>
    </style>
</resources>
